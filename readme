CPU运行命令
1. 基础训练（CPU）
bash
# 使用默认参数训练
python main.py --mode train

# 指定数据目录和节点数量
python main.py --mode train --data_dir ./data --num_nodes 50
2. 训练+推理（CPU）
bash
# 训练并测试
python main.py --mode both --num_nodes 50 --max_epochs 10
3. 仅推理（CPU）
bash
# 使用已有模型进行推理
python main.py --mode inference --model_path best_eshgnn.pt
4. 优化配置训练（CPU）
bash
# 使用优化后的配置进行训练
python main.py --mode train \
    --num_nodes 50 \
    --num_factors 10 \
    --hidden_dim 64 \
    --gru_dim 32 \
    --num_layers 2 \
    --batch_size 4 \
    --learning_rate 1e-3 \
    --max_epochs 30 \
    --T_s 8
5. 完整训练（CPU - 所有参数）
bash
python main.py --mode both \
    --data_dir ./data \
    --dataset CSI-300 \
    --num_nodes 50 \
    --num_features 80 \
    --num_factors 10 \
    --hidden_dim 64 \
    --gru_dim 32 \
    --state_dim 5 \
    --num_layers 2 \
    --tau_base 20.0 \
    --gamma 0.5 \
    --theta_0 0.8 \
    --rho 1.5 \
    --T_s 8 \
    --T_e 30 \
    --batch_size 4 \
    --learning_rate 1e-3 \
    --weight_decay 1e-4 \
    --max_epochs 30 \
    --patience 20 \
    --H 5 \
    --alpha 0.7 \
    --beta 0.3 \
    --seed 42
6. 小规模快速测试（CPU）
bash
# 快速测试模型是否能运行
python main.py --mode train \
    --num_nodes 10 \
    --num_features 20 \
    --num_factors 5 \
    --hidden_dim 16 \
    --gru_dim 8 \
    --num_layers 1 \
    --batch_size 2 \
    --max_epochs 3 \
    --T_s 4
7. 大规模训练（CPU - 适合数据量大的情况）
bash
python main.py --mode train \
    --num_nodes 100 \
    --num_factors 10 \
    --hidden_dim 64 \
    --gru_dim 32 \
    --num_layers 2 \
    --batch_size 8 \
    --learning_rate 1e-3 \
    --max_epochs 50 \
    --T_s 10 \
    --patience 30
8. 使用S&P-500数据集（CPU）
bash
python main.py --mode both \
    --dataset S&P-500 \
    --num_nodes 100 \
    --num_factors 10 \
    --hidden_dim 64 \
    --gru_dim 32 \
    --num_layers 2 \
    --batch_size 8 \
    --max_epochs 30
9. 调试模式（CPU - 打印详细信息）
bash
python main.py --mode train \
    --num_nodes 10 \
    --batch_size 1 \
    --max_epochs 2 \
    --T_s 3 \
    --hidden_dim 8 \
    --num_factors 3
10. 禁用混合精度（CPU默认禁用）
bash
# CPU模式下混合精度自动禁用，无需额外参数
python main.py --mode train --no_amp
CPU专用命令（禁用GPU相关功能）
11. 完全禁用GPU相关功能
bash
# 设置环境变量强制使用CPU
set CUDA_VISIBLE_DEVICES=-1
python main.py --mode train --num_nodes 50 --max_epochs 10
12. 使用CPU和梯度累积
bash
# 梯度累积模拟大批量训练
python main.py --mode train \
    --num_nodes 50 \
    --batch_size 2 \
    --gradient_accumulation_steps 4 \
    --max_epochs 20
13. 调整数据加载Worker（CPU）
bash
# CPU模式下减少worker数量
python main.py --mode train \
    --num_nodes 50 \
    --num_workers 2 \
    --batch_size 4 \
    --max_epochs 10
不同场景推荐配置
场景1: 快速验证（< 1分钟）
bash
python main.py --mode train --num_nodes 20 --max_epochs 3 --batch_size 2 --T_s 4
场景2: 中等规模训练（10-30分钟）
bash
python main.py --mode train --num_nodes 50 --num_factors 10 --hidden_dim 64 --max_epochs 20 --batch_size 4
场景3: 完整训练（1-2小时）
bash
python main.py --mode both \
    --num_nodes 100 \
    --num_factors 10 \
    --hidden_dim 64 \
    --gru_dim 32 \
    --num_layers 2 \
    --batch_size 8 \
    --learning_rate 1e-3 \
    --max_epochs 50 \
    --T_s 10 \
    --patience 30
场景4: 内存受限环境
bash
python main.py --mode train \
    --num_nodes 30 \
    --num_factors 5 \
    --hidden_dim 32 \
    --batch_size 2 \
    --gradient_accumulation_steps 2 \
    --max_epochs 10
注意事项
CPU模式下会自动禁用混合精度训练，无需额外设置

CPU模式不支持多GPU，--use_multi_gpu 参数将被忽略

建议CPU模式下使用较小的batch size（2-8）

--num_workers 在CPU模式下建议设置为2-4

使用 --no_pin_memory 可以进一步减少内存使用

快速开始
bash
# 最简单的CPU运行命令
python main.py --mode both --num_nodes 30 --max_epochs 5 --batch_size 4

# 或使用优化配置
python main.py --mode both \
    --num_nodes 50 \
    --num_factors 8 \
    --hidden_dim 32 \
    --batch_size 4 \
    --learning_rate 1e-3 \
    --max_epochs 20
ICLR-工商数据/
├── main.py                    # 主入口，使用argparse解析超参数
├── config.py                  # 配置类定义
├── data_loader.py             # 数据下载和加载模块
├── trainer.py                 # 训练器
├── inference.py               # 推理引擎
├── utils.py                   # 工具函数
├── models/
│   ├── __init__.py
│   ├── macro_encoder.py       # 宏观状态编码器
│   ├── factor_encoder.py      # 因子特征编码器
│   ├── graph_constructor.py   # 异质图构造器
│   ├── lif_neuron.py          # LIF神经元
│   ├── state_adaptive_gcn.py  # 状态自适应图卷积
│   ├── spiking_gnn_layer.py   # 脉冲GNN层
│   └── eshgnn.py              # 完整模型
└── data/                      # 数据目录（自动创建）
    ├── CSI-300_train.pkl
    ├── CSI-300_val.pkl
    └── CSI-300_test.pkl